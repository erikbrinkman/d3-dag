{
  "name": "d3-dag",
  "version": "1.2.2",
  "description": "Layout algorithms for visualizing directed acyclic graphs.",
  "keywords": [
    "d3",
    "d3-module",
    "layout",
    "dag",
    "infovis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikbrinkman/d3-dag.git"
  },
  "homepage": "https://erikbrinkman.github.io/d3-dag/",
  "author": {
    "name": "Erik Brinkman",
    "email": "erik.brinkman@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "unpkg": "dist/d3-dag.iife.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "/dist/**/*.js",
    "/dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "fmt": "biome format --write",
    "lint:ts": "tsc",
    "lint:es": "biome check",
    "lint:doc": "typedoc --emit none",
    "lint": "bun lint:ts && bun lint:doc && bun lint:es",
    "export:lib": "tsc -p tsconfig.build.json",
    "export:iife": "bun build build/iife.ts --minify --format=iife --target=browser --outfile dist/d3-dag.iife.min.js",
    "export": "bun export:lib && bun export:iife",
    "check:pkg": "publint --strict && attw --pack --profile esm-only",
    "prepack": "bun export",
    "bench": "bun src/dagre.bench.ts",
    "doc": "typedoc && bun build docs-src/compare-app.tsx --minify -e child_process --outfile docs/compare-app.js && bun build docs-src/examples-app.tsx --minify -e child_process --outfile docs/examples-app.js",
    "doc:watch": "typedoc --watch"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "javascript-lp-solver": "^1.0.3",
    "quadprog": "^2.0.0",
    "stringify-object": "^6.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@biomejs/biome": "^2.4.11",
    "@dagrejs/dagre": "^3.0.0",
    "@types/bun": "^1.3.12",
    "@types/d3-array": "^3.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/stringify-object": "^4.0.5",
    "@xyflow/react": "^12.10.2",
    "glob": "^13.0.6",
    "mitata": "^1.0.34",
    "publint": "^0.3.21",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typedoc": "^0.28.18",
    "typescript": "~7.0.2"
  }
}
